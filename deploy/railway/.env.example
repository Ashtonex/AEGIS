ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=https://aegis-frontend-isbu.onrender.com
ALLOWED_HOSTS=aegis-backend-api.up.railway.app
FRONTEND_HOSTNAME=aegis-frontend-isbu.onrender.com

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_KEY=replace-with-supabase-service-role-key
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

REDIS_URL=redis://default:PASSWORD@HOST:PORT
BACKGROUND_JOBS_ENABLED=false
