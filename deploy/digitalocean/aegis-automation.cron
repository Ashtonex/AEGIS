# AEGIS scheduled automation. Installed to /etc/cron.d/aegis-automation by
# .github/workflows/deploy-backend.yml on every backend deploy - edit this
# file, not the droplet. See imperium-api/scripts/README-cron.md.
# Times are UTC (CAT = UTC+2).
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# e-GP tender check -> import -> documents -> new-tender emails, plus email
# retries. Runs every 15 min; discovery only happens when the schedule set in
# CRM -> Tenders & Bids -> Tender automation is due.
*/15 * * * * root aegis-cron-run scripts/run_tender_automation.py >> /var/log/aegis-cron.log 2>&1

# The other scheduled checks in scripts/README-cron.md. Off until someone
# decides to start their notifications (uncomment a line to enable it):
# */15 * * * * root aegis-cron-run scripts/run_activity_reminders.py >> /var/log/aegis-cron.log 2>&1
# 0 * * * *    root aegis-cron-run scripts/run_hse_escalation.py >> /var/log/aegis-cron.log 2>&1
# 0 7 * * *    root aegis-cron-run scripts/run_hr_workforce_alerts.py >> /var/log/aegis-cron.log 2>&1
# 0 7 * * *    root aegis-cron-run scripts/run_compliance_alerts.py >> /var/log/aegis-cron.log 2>&1
# 0 8 * * *    root aegis-cron-run scripts/run_stale_quote_check.py >> /var/log/aegis-cron.log 2>&1
# 0 6 * * 1    root aegis-cron-run scripts/run_weekly_digest.py >> /var/log/aegis-cron.log 2>&1
