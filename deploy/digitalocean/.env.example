ENVIRONMENT=production
DEBUG=false

# Public access
API_HOSTNAME=api.example.com
ALLOWED_HOSTS=api.example.com
ALLOWED_ORIGINS=https://sixnineconstruction.com
FRONTEND_HOSTNAME=sixnineconstruction.com

# Database and auth
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_KEY=replace-with-supabase-service-role-key
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Jobs and cache - the imperium-worker service (arq) requires a managed,
# durable Redis/Valkey instance once BACKGROUND_JOBS_ENABLED=true. The
# droplet's self-hosted `redis` compose service is NOT durable enough to
# trust for jobs that must not silently drop across a redeploy - core/config.py
# refuses to start with BACKGROUND_JOBS_ENABLED=true if REDIS_URL still points
# at that internal `redis://redis:` host, by design.
REDIS_URL=rediss://default:PASSWORD@HOST:PORT/0
BACKGROUND_JOBS_ENABLED=true

# Branded transactional email (invite emails) via Resend. Optional - if left
# unset, invites still work but fall back to Supabase's own unbranded email.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=AEGIS SNC <invites@example.com>
